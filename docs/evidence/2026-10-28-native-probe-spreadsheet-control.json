    "suiteSha256": "897b00d96a2405e9b26d46566d3761993ac895a32dd1cf74e9529e11321e838d",
    "suiteSource": "import assert from 'node:assert/strict';\nimport {execFileSync} from 'node:child_process';\nimport {writeFile} from 'node:fs/promises';\nexport async function probe({call,workspace}) {\n  execFileSync('python',['-c',\"from openpyxl import Workbook; w=Workbook(); w.active.title='Sheet'; w.active['A1']=2; w.active['A2']=3; w.save('/workspace/source.xlsx')\"]);\n  const edits=[{sheet:'Sheet',cell:'B1',value:'=A1+10'},{sheet:'Sheet',cell:'B2',value:'=A2*20'}];\n  const result=await call('workbook_write',{source:'/workspace/source.xlsx',destination:'/workspace/result.xlsx',edits});\n  assert.equal(result.isError,false);\n  const actual=JSON.parse(execFileSync('python',['-c',\"import json; from openpyxl import load_workbook; w=load_workbook('/workspace/result.xlsx'); print(json.dumps([w['Sheet']['B1'].value,w['Sheet']['B2'].value]))\"],{encoding:'utf8'}));\n  await writeFile(workspace+'/explicit-values.json',JSON.stringify({expected:edits.map(x=>x.value),actual}));\n  assert.deepEqual(actual,edits.map(x=>x.value));\n}\n",
