-import { readFile, writeFile } from 'node:fs/promises';
+import { readFile, writeFile, rename, stat } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
 import path from 'node:path';
 
+export const name = 'structured-data';
 export const inject = ['tools'];
+
+const WORKSPACE = '/workspace/';
+const sha256 = (bytes) => createHash('sha256').update(bytes).digest('hex');
+const textOutput = (value) => [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value) }];
+
+/** Resolve `destination` inside /workspace, rejecting traversal and the bare root. */
+function resolveWorkspacePath(destination) {
+  if (typeof destination !== 'string' || destination.length === 0) {
+    throw new Error('destination must be a non-empty path inside /workspace');
+  }
+  const resolved = path.resolve(WORKSPACE, destination);
+  if (resolved === '/workspace' || !resolved.startsWith(WORKSPACE)) {
+    throw new Error(`destination must be inside /workspace (resolved: ${resolved})`);
+  }
+  return resolved;
+}
+
+/** Split a text file into records without normalizing any value. */
+function splitText(text, format) {
+  if (format === 'json') {
+    const value = JSON.parse(text);
+    return Array.isArray(value) ? value : [value];
+  }
+  const records = [];
+  for (const line of text.split('\n')) {
+    const trimmed = line.endsWith('\r') ? line.slice(0, -1) : line;
+    if (trimmed.trim() === '') continue;
+    records.push(JSON.parse(trimmed));
+  }
+  return records;
+}
+
+function kindOf(value) {
+  if (value === null) return 'null';
+  if (Array.isArray(value)) return 'array';
+  if (typeof value === 'number') return Number.isInteger(value) ? 'integer' : 'number';
+  return typeof value;
+}
+
+function matchesType(value, declared) {
+  if (declared === 'json') return true;
+  if (declared === 'integer') return kindOf(value) === 'integer';
+  if (declared === 'number') return typeof value === 'number' && Number.isFinite(value);
+  return kindOf(value) === declared;
+}
+
+const describeType = (declared) => (declared === 'json' ? 'any JSON value' : declared);
+
+/** Compare records or one object root against an explicit declared shape. */
+function collectFindings(shape, records) {
+  const properties = shape.properties ?? {};
+  const keys = Object.keys(properties);
+  const findings = [];
+
+  if (shape.kind === 'records') {
+    const keysSeen = new Set();
+    let missingCount = 0;
+    let mismatchCount = 0;
+    let extraCount = 0;
+    let objectRecords = 0;
+    records.forEach((record, index) => {
+      if (kindOf(record) !== 'object') {
+        findings.push({ code: 'record_not_object', index, path: null, expected: 'object', actual: kindOf(record) });
+        return;
+      }
+      objectRecords += 1;
+      const missing = keys.filter((key) => !Object.hasOwn(record, key));
+      const mismatched = keys.filter((key) => Object.hasOwn(record, key) && !matchesType(record[key], properties[key]));
+      const extra = Object.keys(record).filter((key) => !Object.hasOwn(properties, key));
+      for (const key of Object.keys(record)) keysSeen.add(key);
+      missingCount += missing.length;
+      mismatchCount += mismatched.length;
+      extraCount += extra.length;
+      for (const key of missing) findings.push({ code: 'missing_field', index, path: key, expected: describeType(properties[key]), actual: 'absent' });
+      for (const key of mismatched) findings.push({ code: 'type_mismatch', index, path: key, expected: describeType(properties[key]), actual: kindOf(record[key]) });
+      for (const key of extra) findings.push({ code: 'unexpected_field', index, path: key, expected: 'absent', actual: kindOf(record[key]) });
+    });
+    return {
+      kind: 'records',
+      declaredKeys: keys,
+      recordCount: records.length,
+      objectRecords,
+      observedKeys: [...keysSeen].sort(),
+      missingFieldOccurrences: missingCount,
+      typeMismatchOccurrences: mismatchCount,
+      extraFieldOccurrences: extraCount,
+      findings,
+    };
+  }
+
+  const root = records[0] ?? null;
+  const facts = { kind: 'object', declaredKeys: keys, rootType: kindOf(root), missingKeys: [], typeMismatches: [], extraKeys: [] };
+  if (kindOf(root) !== 'object') {
+    facts.missingKeys = [...keys];
+    findings.push({ code: 'root_not_object', index: null, path: null, expected: 'object', actual: kindOf(root) });
+    return { ...facts, findings };
+  }
+  for (const key of keys) {
+    if (!Object.hasOwn(root, key)) {
+      facts.missingKeys.push(key);
+      findings.push({ code: 'missing_key', index: null, path: key, expected: describeType(properties[key]), actual: 'absent' });
+      continue;
+    }
+    const value = root[key];
+    if (!matchesType(value, properties[key])) {
+      facts.typeMismatches.push(key);
+      findings.push({ code: 'type_mismatch', index: null, path: key, expected: describeType(properties[key]), actual: kindOf(value) });
+      continue;
+    }
+    if (properties[key] === 'array') {
+      facts[`${key}Length`] = value.length;
+      facts[`${key}ItemKinds`] = [...new Set(value.map(kindOf))].sort();
+    }
+  }
+  for (const key of Object.keys(root)) {
+    if (!Object.hasOwn(properties, key)) {
+      facts.extraKeys.push(key);
+      findings.push({ code: 'unexpected_key', index: null, path: key, expected: 'absent', actual: kindOf(root[key]) });
+    }
+  }
+  return { ...facts, findings };
+}
+
+/** Best-effort durable citation of a read or commit; never fails the tool. */
+function cite(exec, type, payload) {
+  const session = exec?.agent?.session ?? exec?.session;
+  if (session === undefined || typeof session.append !== 'function') return;
+  try {
+    session.append(type, { ...payload, call: exec.rootCallId ?? exec.callId });
+  } catch {
+    /* the tool's returned facts remain authoritative */
+  }
+}
