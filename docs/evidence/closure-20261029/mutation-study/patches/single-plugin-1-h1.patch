+    final = load_workbook(destination)
+    textish = text_formula_cells(final)
+    if textish:
+        warnings.append("values stored as text rather than formulas: " + ", ".join(textish[:20]))
+
+    if result["formula_values_recalculated"]:
+        formulas = formula_plan(final)
+        values = compiled_values(destination) or {}
+        error_cells = [
+            f"{cell} (formula {formulas.get(cell)})"
+            for cell, value in values.items()
+            if isinstance(value, str) and ERROR_TEXT.match(value.strip())
+        ]
+        if error_cells:
+            warnings.append("engine returned error values at " + ", ".join(error_cells[:20]))
+        missing = [name for name in formulas if name not in values]
+        if missing:
+            warnings.append(f"{len(missing)} formula cells produced no value")
+        filled = {}
+        for edit in args["edits"]:
+            key = f"{edit['sheet']}!{str(edit['cell']).replace('$', '')}"
+            if key in values:
+                filled[key] = values[key]
+        result["values"] = filled
+    if warnings:
+        result["warnings"] = warnings
+    return result
+
+
+def op_recalc(args):
+    source = resolve_inside(args["source"], [Path("/")])
+    destination = resolve_inside(args["destination"], [Path("/workspace")])
+    outcome = recalculate(source, destination)
+    if outcome.get("recalculated"):
+        outcome["saved"] = str(destination)
+        outcome["values"] = compiled_values(destination)
+    return outcome
+
+
+def main():
+    args = json.loads(sys.stdin.read())
+    operation = args.get("operation")
+    if operation == "inspect":
+        result = op_inspect(args)
+    elif operation == "write":
+        result = op_write(args)
+    elif operation == "recalc":
+        result = op_recalc(args)
+    else:
+        raise ValueError("Unknown workbook operation")
+    print(json.dumps(result, default=str))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except Exception as exc:
+        sys.stderr.write(f"{type(exc).__name__}: {exc}\n")
+        sys.exit(1)
