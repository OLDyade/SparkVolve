+"""Workbook helper used by the spreadsheet harness plugin.
+
+Operations (selected with the JSON `operation` field on stdin):
+
+  inspect  -- dump occupied cells, formulas and comments of a workbook.
+  write    -- apply caller-supplied values/formulas to a copy of a workbook,
+              verify the result and (optionally) recalculate it with an
+              independent engine so cached values are available to consumers
+              that do not recalculate.
+  recalc   -- recalculate any existing workbook to a destination.
+
+Design notes
+------------
+* The helper never decides what a formula should be: every value comes from
+  the caller. It only detects engine-level problems (formulas stored as text,
+  error values, out-of-range references) so a wrong edit is visible.
+* The standard library's ``zipfile`` writes a zip layout that the bundled
+  LibreOffice sometimes refuses to open, while openpyxl's own save path is
+  readable. The workbook is therefore always produced through openpyxl and
+  the recalculation input is always a fresh openpyxl save.
+"""
+
 import json
+import os
+import re
+import shutil
+import subprocess
 import sys
+import tempfile
 from pathlib import Path
-from openpyxl import load_workbook
-from openpyxl.utils.cell import coordinate_to_tuple
