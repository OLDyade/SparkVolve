+def translate_formula(template, origin, destination):
+    """Shift relative references from the template cell to the destination cell,
+    exactly as a spreadsheet fill-right would."""
+    try:
+        return Translator(template, origin=origin).translate_formula(destination)
+    except Exception:  # noqa: BLE001 - keep the raw template if it cannot be parsed
+        return template
+
+
+def recalc(target, requested):
+    """Recalculate a saved workbook with LibreOffice and report cached values."""
+    office = shutil.which('soffice') or shutil.which('libreoffice')
+    if not office:
+        return {'recalculated': False, 'reason': 'LibreOffice not available'}
+    with tempfile.TemporaryDirectory() as tmp:
+        home = Path(tmp) / 'home'
+        home.mkdir()
+        env = dict(os.environ, HOME=str(home))
+        try:
+            subprocess.run(
+                [office, '--headless', '--norestore', '--calc',
+                 '--convert-to', 'xlsx', '--outdir', tmp, str(target)],
+                check=True, capture_output=True, timeout=180, env=env,
+            )
+        except Exception as exc:  # noqa: BLE001 - report, never break the write
+            return {'recalculated': False, 'reason': f'LibreOffice failed: {exc}'}
+        produced = Path(tmp) / Path(target).name
+        if not produced.exists():
+            return {'recalculated': False, 'reason': 'LibreOffice produced no file'}
+        values = load_workbook(produced, data_only=True)
+        report = {}
+        for sheet_name, cells in requested.items():
+            sheet = values[sheet_name] if sheet_name in values.sheetnames else None
+            target_report = report.setdefault(sheet_name, {})
+            for cell in cells:
+                target_report[cell] = sheet[cell].value if sheet is not None else None
+    return {'recalculated': True, 'values': report}
+
 
