+def recalc_values(path):
+    with tempfile.TemporaryDirectory() as tmp:
+        subprocess.run(
+            ['soffice', '--headless', '--calc', '--convert-to', 'xlsx', '--outdir', tmp, str(path)],
+            check=True,
+            capture_output=True,
+            timeout=240,
+        )
+        converted = Path(tmp) / (Path(path).stem + '.xlsx')
+        if not converted.exists():
+            raise RuntimeError('LibreOffice produced no recalculated workbook')
+        data = load_workbook(converted, data_only=True)
+        return {(sheet.title, cell.coordinate): cell.value for sheet in data for row in sheet for cell in row}
+
+
+def cell_value(values, sheet, coord):
+    return values.get((sheet, coord))
+
+
+def is_error(value):
+    return isinstance(value, str) and value.startswith('#')
+
+
+def column_types(sheet):
+    types = {}
+    for col_letters in sorted({re.sub(r"[0-9]+", "", c.coordinate) for row in sheet for c in row}):
+        numeric = text = 0
+        for cell in sheet[col_letters]:
+            if isinstance(cell.value, (int, float)) and not isinstance(cell.value, bool):
+                numeric += 1
+            elif isinstance(cell.value, str) and not cell.value.startswith('='):
+                text += 1
+        types[col_letters] = 'numeric' if numeric > text else ('text' if text else 'empty')
+    return types
+
+
+def snapshot(sheet, values):
+    return {cell.coordinate: {'stored': cell.value,
+                              'computed': cell_value(values, sheet.title, cell.coordinate),
+                              'comment': cell.comment.text if cell.comment else None}
+            for row in sheet for cell in row
+            if cell.value is not None or cell.comment}
+
 
