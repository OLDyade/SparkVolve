+
+# --------------------------------------------------------------------------
+# small helpers
+# --------------------------------------------------------------------------
+def resolve_inside(path, roots):
+    """Absolute path for `path`; reject anything outside an allowed root."""
+    target = Path(path).expanduser().resolve()
+    for root in roots:
+        try:
+            if target.is_relative_to(root):
+                return target
+        except OSError:
+            continue
+    raise ValueError(
+        "Path must be inside " + " or ".join(str(r) for r in roots) + f": {target}"
+    )
+
+
+def drop_readonly(path):
+    try:
+        if path.exists() and not os.access(path, os.W_OK):
+            path.chmod(path.stat().st_mode | 0o200)
+    except OSError:
+        pass
+
+
+def validate_formula(sheet, text):
+    """Return a list of engine-level problems with a formula string."""
+    problems = []
+    body = text[1:] if text[:1] == "=" else text
+    if not body.strip():
+        return ["empty formula"]
+    if body.count("(") != body.count(")"):
+        problems.append("unbalanced parentheses")
+    if body.count('"') % 2:
+        problems.append("unbalanced quotes")
+    # Drop sheet-qualified and function tokens before scanning references.
+    scrubbed = re.sub(r"'[^']*'!", "", body)
+    scrubbed = re.sub(r"[A-Za-z_][A-Za-z0-9_.]*!", "", scrubbed)
+    for match in re.finditer(r"\$?([A-Za-z]{1,3})\$?([0-9]{1,7})", scrubbed):
+        letters, digits = match.group(1), int(match.group(2))
+        try:
+            column_index_from_string(letters.upper())
+        except (ValueError, KeyError):
+            continue
+        if sheet.max_column and sheet.max_column + 1:
+            pass
+        if digits > 1048576:
+            problems.append(f"reference beyond the sheet grid ({match.group(0)})")
+    return problems
+
+
+def libreoffice_binary():
+    for name in ("soffice", "libreoffice"):
+        found = shutil.which(name)
+        if found:
+            return found
+    return None
+
+
+def recalculate(source, destination):
+    """Recalculate `source` with LibreOffice into `destination`.
+
+    The input is re-saved through openpyxl first: a zip layout produced by the
+    stdlib is not always readable by the bundled engine, while the openpyxl
+    writer is. Returns a dict describing the outcome; never raises for engine
+    problems so the caller can report them.
+    """
+    binary = libreoffice_binary()
+    if binary is None:
+        return {"recalculated": False, "reason": "LibreOffice not installed"}
+    work = Path(tempfile.mkdtemp(prefix="recalc-"))
+    try:
+        staged = work / "input" / "workbook.xlsx"
+        staged.parent.mkdir(parents=True, exist_ok=True)
+        load_workbook(source).save(staged)
+        out = work / "out"
+        out.mkdir()
+        proc = subprocess.run(
+            [binary, "--headless", "--convert-to", "xlsx", "--outdir", str(out), str(staged)],
+            capture_output=True,
+            text=True,
+            timeout=300,
+            cwd=str(work),
+        )
+        produced = out / "workbook.xlsx"
+        if not produced.is_file():
+            return {
+                "recalculated": False,
+                "reason": (proc.stderr or proc.stdout or "no output").strip()[-400:],
+            }
+        if compiled_values(produced) is None:
+            return {"recalculated": False, "reason": "recalculated file has no cached values"}
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        drop_readonly(destination)
+        shutil.copyfile(produced, destination)
+        return {"recalculated": True}
+    except subprocess.TimeoutExpired:
+        return {"recalculated": False, "reason": "recalculation timed out"}
+    except Exception as exc:  # pragma: no cover - defensive
+        return {"recalculated": False, "reason": f"{type(exc).__name__}: {exc}"}
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+
+
+def compiled_values(path):
+    """Cached values of every non-empty cell, keyed Sheet!CELL; None if none."""
+    cached = load_workbook(path, data_only=True)
+    found = {}
+    for sheet in cached.worksheets:
+        for row in sheet.iter_rows():
+            for item in row:
+                if item.value is not None:
+                    found[f"{sheet.title}!{item.coordinate}"] = item.value
+    return found or None
+
+
+def formula_plan(book):
+    """Every formula cell in a workbook, with its stored text."""
+    plan = {}
+    for sheet in book.worksheets:
+        for row in sheet.iter_rows():
+            for item in row:
+                if isinstance(item.value, str) and item.value.startswith("="):
+                    plan[f"{sheet.title}!{item.coordinate}"] = str(item.value)
+    return plan
+
+
+def text_formula_cells(book):
+    """Cells whose stored value looks like a formula but is plain text."""
+    suspicious = []
+    for sheet in book.worksheets:
+        for row in sheet.iter_rows():
+            for item in row:
+                value = item.value
+                if isinstance(value, str) and not value.startswith("="):
+                    if re.search(r"[A-Za-z_]+\s*\(", value) and re.search(
+                        r"\d|[A-Za-z]{1,3}[0-9]+", value
+                    ):
+                        suspicious.append(f"{sheet.title}!{item.coordinate}")
+    return suspicious
+
+
+# --------------------------------------------------------------------------
+# operations
+# --------------------------------------------------------------------------
+def op_inspect(args):
+    path = resolve_inside(args["file"], [Path("/")])
+    book = load_workbook(path, data_only=bool(args.get("values")))
+    formulas = formula_plan(load_workbook(path))
+    payload = {"sheets": [sheet.title for sheet in book.worksheets], "cells": {}}
+    for sheet in book.worksheets:
+        cells = []
+        for row in sheet.iter_rows():
+            for item in row:
+                comment = item.comment.text if item.comment else None
+                if item.value is None and not comment:
+                    continue
+                entry = {
+                    "cell": item.coordinate,
+                    "comment": comment,
+                    "type": item.data_type,
+                    "value": item.value,
+                }
+                key = f"{sheet.title}!{item.coordinate}"
+                if key in formulas:
+                    entry["formula"] = formulas[key]
+                cells.append(entry)
+        payload["cells"][sheet.title] = cells
+        payload.setdefault("dimensions", {})[sheet.title] = sheet.dimensions
+        payload.setdefault("merged", {})[sheet.title] = [
+            str(span) for span in sheet.merged_cells.ranges
+        ]
+        payload.setdefault("comments", {})
+        payload["comments"][sheet.title] = {
+            f"{sheet.title}!{item.coordinate}": item.comment.text
+            for row in sheet.iter_rows()
+            for item in row
+            if item.comment
+        }
+    payload["formula_count"] = len(formulas)
+    payload["formulas"] = formulas
+    return payload
+
+
+def op_write(args):
+    source = resolve_inside(args["source"], [Path("/")])
+    destination = resolve_inside(args["destination"], [Path("/workspace")])
+    book = load_workbook(source)
     seen = set()
