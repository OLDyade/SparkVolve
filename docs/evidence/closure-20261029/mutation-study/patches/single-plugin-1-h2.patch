+
+sys.dont_write_bytecode = True
+
+ERROR_TEXT = re.compile(r"^#(?:NULL!|DIV/0!|VALUE!|REF!|NAME\?|NUM!|N/A)$")
+
+from openpyxl import load_workbook  # noqa: E402
+from openpyxl.utils.cell import (  # noqa: E402
+    column_index_from_string,
+    coordinate_to_tuple,
+)
