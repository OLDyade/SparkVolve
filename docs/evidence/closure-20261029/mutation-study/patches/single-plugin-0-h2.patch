+from openpyxl.utils.cell import coordinate_to_tuple, get_column_letter
+from openpyxl.formula.translate import Translator
+
+
+def shift(template, origin, destination):
+    """Relative-reference shift used by a spreadsheet 'fill right'. A reference is
+    only rewritten when it points into the template cell's column block being
+    filled (i.e. when it is anchored in the same column as the template)."""
+    try:
+        return Translator(template, origin=origin).translate_formula(destination)
+    except Exception:  # noqa: BLE001
+        return template
+
+
+def audit(source, target):
+    """Diff a finished workbook against its source: untouched inputs, filled cells."""
+    before = load_workbook(source)
+    after = load_workbook(target)
+    problems = []
+    changed = []
+    for sheet in before:
+        if sheet.title not in after.sheetnames:
+            problems.append(f'missing sheet {sheet.title}')
+            continue
+        other = after[sheet.title]
+        for row in sheet.iter_rows():
+            for cell in row:
+                now = other[cell.coordinate].value
+                if cell.value is not None and now != cell.value:
+                    problems.append(f'{sheet.title}!{cell.coordinate} original content changed: '
+                                    f'{cell.value!r} -> {now!r}')
+                if cell.value is None and now is not None:
+                    changed.append(f'{sheet.title}!{cell.coordinate}')
+    for sheet in after:
+        if sheet.title not in before.sheetnames:
+            problems.append(f'added sheet {sheet.title}')
+    formulas = {}
+    for name in after.sheetnames:
+        sheet = after[name]
+        formulas[name] = {c.coordinate: c.value for row in sheet.iter_rows() for c in row
+                          if isinstance(c.value, str) and c.value.startswith('=')}
+    return problems, changed, formulas
+
 
