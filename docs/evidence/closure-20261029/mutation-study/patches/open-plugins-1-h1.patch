--- a/workbook.py
+++ b/workbook.py
@@ -1,9 +1,39 @@
 import json
+import subprocess
 import sys
+import tempfile
 from pathlib import Path
+
 from openpyxl import load_workbook
 from openpyxl.utils.cell import coordinate_to_tuple
 
+
+def errors_only(value):
+    return isinstance(value, str) and value.startswith('#')
+
+
+def recalc_values(path):
+    """Recalculate with LibreOffice and return {(sheet, coord): value}."""
+    with tempfile.TemporaryDirectory() as tmp:
+        subprocess.run(
+            ['soffice', '--headless', '--calc', '--convert-to', 'xlsx', '--outdir', tmp, str(path)],
+            check=True,
+            capture_output=True,
+            timeout=240,
+        )
+        converted = Path(tmp) / (Path(path).stem + '.xlsx')
+        if not converted.exists():
+            raise RuntimeError('LibreOffice produced no recalculated workbook')
+        data = load_workbook(converted, data_only=True)
+        values = {}
+        for sheet in data:
+            for row in sheet:
+                for cell in row:
+                    if cell.value is not None:
+                        values[(sheet.title, cell.coordinate)] = cell.value
+        return values
+
+
 args = json.load(sys.stdin)
 if args['operation'] == 'inspect':
     workbook = load_workbook(args['file'])
@@ -25,5 +55,34 @@ elif args['operation'] == 'write':
     target.parent.mkdir(parents=True, exist_ok=True)
     workbook.save(target)
     print(json.dumps({'saved': str(target), 'submitted_cells': len(seen), 'formula_values_recalculated': False}))
+elif args['operation'] == 'recalc':
+    path = Path(args['file'])
+    workbook = load_workbook(path)
+    values = recalc_values(path)
+    sheets = {}
+    problems = []
+    for sheet in workbook:
+        rows = []
+        for row in sheet:
+            for cell in row:
+                formula = cell.value
+                if formula is None and not cell.comment:
+                    continue
+                computed = values.get((sheet.title, cell.coordinate))
+                entry = {'cell': cell.coordinate}
+                if isinstance(formula, str) and formula.startswith('='):
+                    entry['formula'] = formula
+                elif formula is not None:
+                    entry['value'] = formula
+                if computed is not None:
+                    entry['computed'] = computed
+                if cell.comment:
+                    entry['comment'] = cell.comment.text
+                if errors_only(computed):
+                    problems.append(f'{sheet.title}!{cell.coordinate} {computed}')
+                rows.append(entry)
+        sheets[sheet.title] = rows
+    print(json.dumps({'file': str(path), 'recalculated': True, 'sheets': sheets,
+                      'formula_errors': problems}, default=str))
 else:
     raise ValueError('Unknown workbook operation')
