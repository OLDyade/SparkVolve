+    return {
+        'file': args['file'],
+        'sheets': result,
+        'note': 'Stored contents. A string starting with "=" is an Excel formula. '
+                'Comments are original source facts, not business conclusions.',
+    }
+
+
+def do_write(args):
     target = Path(args['destination']).resolve()
-    if not target.is_relative_to('/workspace'):
