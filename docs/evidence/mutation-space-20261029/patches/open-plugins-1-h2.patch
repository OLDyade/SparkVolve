+"""Spreadsheet engine: inspect, write (formula-preserving), recalculate, verify.
+
+Derived from the baseline workbook.py. It keeps the baseline's two
+proven operations (`inspect`, `write`) and adds:
+
+  * `recalculate` - evaluate every formula in a delivered workbook through an
+    independent engine (LibreOffice headless) and report computed values and
+    error cells. The bridge that grades deliveries recalculates formulas; a raw
+    openpyxl file carries no cached values, so this is the only way an agent can
+    see what the independent engine will see before handing the file in.
+  * `verify` - recalculate and compare named cells against caller-supplied
+    expectations, returning per-cell pass/fail so a wrong assumption is caught
+    before delivery instead of after.
+
+Nothing here infers business semantics or business answers: callers supply the
+formulas and the expectations. The engine only computes and compares.
+"""
 import json
+import shutil
+import subprocess
 import sys
+import tempfile
 from pathlib import Path
+
 from openpyxl import load_workbook
 from openpyxl.utils.cell import coordinate_to_tuple
 
-args = json.load(sys.stdin)
-if args['operation'] == 'inspect':
