+
+
+def partial_fill_findings(sheet, rows, columns):
+    findings = []
+    for row, info in sorted(rows.items()):
+        filled = [c for c in columns if sheet.cell(row=row, column=c).value not in (None, '')]
+        if not filled:
+            continue
+        missing = [c for c in columns if c not in filled]
+        if missing and len(filled) > 1:
+            findings.append({
+                'issue': 'partial_row', 'row': row, 'label': info['label'],
+                'empty_columns': missing,
+                'message': 'Row "%s" is filled for some columns only. Fill every displayed '
+                           'period column for it, or leave the row entirely blank if the '
+                           'workbook intends that.' % info['label'],
+            })
+    return findings
+
+
+def preserved_findings(source, delivery):
+    changes = []
+    if not Path(source).exists():
+        return [{'issue': 'source_missing', 'message': 'source not found: %s' % source}]
+    before = load_workbook(source)
+    for sheet in before:
+        if sheet.title not in delivery.sheetnames:
+            changes.append({'sheet': sheet.title, 'cell': '', 'kind': 'sheet_missing'})
+            continue
