+                    'label': rows[row]['label'], 'column': column,
+                    'message': 'The exit/terminal row for "%s" has a value outside the final '
+                               'period. Exit value is computed once, in the final year; the '
+                               'earlier cells are intentionally blank.' % rows[row]['label'],
+                })
+                break
+    return findings
+
+
+def write_back_findings(wb, sheet, values_wb, title):
+    """Formulas must remain formulas and must compute to a value."""
+    findings = []
+    computed = values_wb[title] if values_wb is not None and title in values_wb.sheetnames else None
