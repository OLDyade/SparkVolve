+
+
+def is_formula(value):
+    return isinstance(value, str) and value.startswith('=')
+
+
+def is_number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def norm(value):
+    if value is None:
+        return ''
+    text = str(value).strip().lower()
+    for char in (':', '_', '-', '.', '/', '('):
+        text = text.replace(char, ' ')
+    text = text.replace(')', ' ')
+    return ' '.join(text.split())
+
+
+def any_of(text, needles):
+    return any(needle in text for needle in needles)
+
+
+def indent_of(workbook, cell):
+    if not cell.has_style:
+        return 0
+    try:
+        return int(workbook._fonts[cell._style.fontId].indent or 0)
+    except Exception:
+        return 0
+
+
+def is_percent(cell):
+    return '%' in (cell.number_format or '')
+
+
+def num(value):
+    return value if is_number(value) else None
+
+
+# ---------------------------------------------------------------------------
+# labels -> roles
+# ---------------------------------------------------------------------------
+
+HURTS = ('expense', 'cost', 'interest', 'loss', 'amortization', 'depreciation',
+         'repayment', 'principal', 'principal payment', 'capex', 'tax')
+HELPS = ('gain', 'recurring gain', 'benefit', 'income', 'add back', 'addback')
+LINETOTALS = ('ebt', 'ebitda', 'ebit', 'operating income', 'pretax income',
+              'pre tax income', 'earnings before')
+ADJUSTMENT = ('non recurring', 'nonrecurring', 'adjust', 'one time', 'onetime',
+              'add back', 'addback')
+BLOCKTOTAL = ('normalized', 'adjusted', 'underlying', 'operating', 'pro forma', 'proforma')
+EXIT = ('exit', 'terminal', 'enterprise value', 'equity value')
+
+
+def role(label):
+    text = norm(label)
+    if not text:
+        return 'blank'
+    if 'margin' in text:
+        return 'margin'
+    if is_rate_row(text):
+        return 'rate'
+    if any_of(text, ('exit ', 'exit_', 'terminal', 'implied')):
+        return 'exit'
+    if any_of(text, ADJUSTMENT) or (any_of(text, HURTS + HELPS) and
+                                    any_of(text, ('adjustment', 'add back', 'addback'))):
+        return 'adjustment'
+    if any_of(text, LINETOTALS):
+        return 'line'
+    return 'other'
+
+
+def is_rate_row(text):
+    if 'margin' in text or 'multiple' in text or 'growth' in text or 'escalation' in text:
+        return any_of(text, ('margin', 'multiple', 'growth', 'escalation'))
+    if 'rate' in text and ('tax rate' in text or 'adjustment tax' in text or
+                           'apply' in text or 'only' in text):
+        return True
+    if text.startswith('gain adjustment tax') or text.startswith('expense adjustment tax'):
+        return True
+    return False
+
+
+def direction(text, sign=1):
+    """+1 when the row raises the block total, -1 when it lowers it."""
+    text = ' ' + norm(text) + ' '
+    negative = any_of(text, (' expense', ' costs', ' interest', ' loss', ' repayment',
+                             ' principal', ' capex', ' tax'))
+    positive = any_of(text, (' gain', ' benefit', ' income', ' profit'))
+    if negative and not positive:
+        return -1 * sign
+    if positive and not negative:
+        return 1 * sign
+    if text.strip().startswith('effect'):
+        return sign
+    return 0
+
+
+# ---------------------------------------------------------------------------
+# workbook value access
+# ---------------------------------------------------------------------------
+
+
+def libreoffice():
+    for name in ('soffice', 'libreoffice', 'localc'):
+        found = shutil.which(name)
+        if found:
+            return found
+    return None
+
+
+def recalculate(path):
+    """Return (recalculated_path, engine, error). The caller cleans temp dir."""
+    binary = libreoffice()
+    if not binary:
+        return None, None, 'no LibreOffice binary on PATH'
+    outdir = Path(tempfile.mkdtemp(prefix='recalc-'))
+    try:
+        proc = subprocess.run(
+            [binary, '--headless', '--calc', '--convert-to', 'xlsx',
+             '--outdir', str(outdir), str(path)],
+            capture_output=True, text=True, timeout=240,
+        )
+    except subprocess.TimeoutExpired:
+        shutil.rmtree(outdir, ignore_errors=True)
+        return None, None, 'LibreOffice conversion timed out'
+    produced = Path(outdir) / (Path(path).stem + '.xlsx')
+    if not produced.exists():
+        detail = (proc.stderr or proc.stdout or '').strip()[-500:]
+        shutil.rmtree(outdir, ignore_errors=True)
+        return None, None, 'LibreOffice produced no output: ' + detail
+    return produced, 'libreoffice', None
+
+
+def column_letters(sheet, first_col=2):
+    last = 0
+    for row in sheet.iter_rows():
+        for cell in row:
+            if cell.column > 1 and (cell.value is not None):
+                last = max(last, cell.column)
+    return list(range(first_col, last + 1))
+
+
+def values_maps(workbook, title, columns, rows=range(1, 1)):
+    """Computed numbers per period column, taken from a data_only workbook."""
+    sheet = workbook[title]
+    out = {}
+    for column in columns:
+        out[column] = {
+            row: num(sheet.cell(row=row, column=column).value)
+            for row in (rows or range(1, sheet.max_row + 1))
+        }
+    return out
+
+
+def labelled_rows(formula_workbook, sheet):
+    rows = {}
+    for row in range(1, sheet.max_row + 1):
+        cell = sheet.cell(row=row, column=1)
+        if cell.value is None or str(cell.value).strip() == '':
+            continue
+        rows[row] = {'label': str(cell.value).strip(), 'role': role(cell.value),
+                     'indent': indent_of(formula_workbook, cell)}
+    return rows
+
+
+# ---------------------------------------------------------------------------
+# findings
+# ---------------------------------------------------------------------------
+
+
+def margin_scale_findings(sheet, rows, values, columns):
+    findings = []
+    for row, info in sorted(rows.items()):
+        if info['role'] != 'margin':
+            continue
+        for column in columns:
+            value = values.get(column, {}).get(row)
+            if value is None:
+                continue
+            if is_percent(sheet.cell(row=row, column=column)):
+                continue
+            if 1.5 < abs(value) <= 100.5:
+                findings.append({
+                    'issue': 'margin_scale', 'row': row, 'label': info['label'],
+                    'column': column, 'value': value,
+                    'message': 'Margin values are fractions in this workbook; a value of %s '
+                               'in a plain-formatted cell suggests a stray x100. Return the '
+                               'fraction and leave unit/format unchanged.' % value,
+                })
+                break
+    return findings
+
+
+def rate_relabel_findings(wb, sheet, rows, values, columns):
+    """A percent-formatted metric where the source puts percentages on a rate row."""
+    findings = []
+    rate_rows = [r for r, i in rows.items() if i['role'] == 'rate']
+    metric_rows = [r for r, i in rows.items()
+                   if i['role'] in ('other',) and is_percent(sheet.cell(row=r, column=1))]
+    if not rate_rows:
+        return findings
+    for row in metric_rows:
+        label = norm(rows[row]['label'])
+        if any_of(label, ('margin', 'ratio', 'percent')):
+            continue
+        findings.append({
+            'issue': 'percent_on_metric_row', 'row': row, 'label': rows[row]['label'],
+            'message': '"%s" is percent-formatted like a rate row, but the input percentages '
+                       'live on a rate row and each rate applies only to its own adjustment. '
+                       'A rate is never a metric row; check that this row is not a mislabelled '
+                       'rate before filling it.' % rows[row]['label'],
+        })
+    return findings
+
+
+def exit_row_findings(rows, values, columns):
+    """Exit/terminal values appear only in the final column."""
+    findings = []
+    exit_rows = [r for r, i in rows.items() if i['role'] == 'exit']
+    if not exit_rows or len(columns) < 2:
