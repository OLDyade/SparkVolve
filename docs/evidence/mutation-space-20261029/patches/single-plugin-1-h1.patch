+def op_recalc(args):
+    path, engine, error = recalculate(args['file'])
+    if path is None:
+        raise ValueError(error or 'recalculation failed')
+    try:
+        computed = load_workbook(path, data_only=True)
+        formulas = load_workbook(args['file'])
+        payload = {}
+        for sheet in computed:
+            source = formulas[sheet.title] if sheet.title in formulas.sheetnames else None
+            entries = []
+            for row in sheet.iter_rows():
