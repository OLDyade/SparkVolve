+                    changes.append({'sheet': sheet.title, 'cell': cell.coordinate,
+                                    'kind': 'comment_changed'})
+                if target.value != cell.value:
+                    kind = 'text_changed' if isinstance(cell.value, str) else 'source_value_changed'
+                    changes.append({'sheet': sheet.title, 'cell': cell.coordinate,
+                                    'kind': kind, 'before': cell.value, 'after': target.value})
+    return [{'issue': 'source_not_preserved', 'changes': changes,
+             'message': 'Original inputs, labels, units and comments must be preserved '
+                        'exactly; only the intended target cells should change.'}] if changes else []
+
+
