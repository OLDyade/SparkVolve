+                                            'engine recalculated the workbook.'})
+            elif isinstance(value, str) and value.startswith('#'):
+                findings.append({'issue': 'formula_error', 'cell': cell.coordinate,
+                                 'formula': cell.value, 'value': value,
+                                 'message': 'This formula evaluates to an error.'})
