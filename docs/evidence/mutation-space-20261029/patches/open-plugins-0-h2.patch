+            properties: {
+              sheet: { type: 'string', required: true },
+              cell: { type: 'string', required: true },
+            },
+          },
+        },
+      },
+      output,
+      execute: (args, exec) => invoke({ operation: 'verify', ...args }, exec.signal),
+    }),
+  );
 }
