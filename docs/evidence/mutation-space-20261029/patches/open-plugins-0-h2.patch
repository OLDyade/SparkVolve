+def recalculate(source):
+    """Recalculate an XLSX with LibreOffice, returning work dir and recalculated copy."""
+    work = Path(tempfile.mkdtemp(prefix='wbverify-'))
+    try:
+        staged = work / 'in.xlsx'
+        shutil.copyfile(source, staged)
+        out_dir = work / 'out'
+        out_dir.mkdir()
+        profile = work / 'profile'
+        result = subprocess.run(
+            [
+                'soffice',
+                '--headless',
+                '--norestore',
+                '--nologo',
+                '--invisible',
+                f'-env:UserInstallation=file://{profile}',
+                '--convert-to',
+                'xlsx',
+                '--outdir',
+                str(out_dir),
+                str(staged),
+            ],
+            capture_output=True,
+            timeout=240,
+        )
+        produced = out_dir / 'in.xlsx'
+        if not produced.exists():
+            raise RuntimeError(
+                'Recalculation failed: ' + result.stderr.decode('utf-8', 'replace')[-2000:]
+            )
+        return work, produced
+    except Exception:
+        shutil.rmtree(work, ignore_errors=True)
+        raise
+
+
+def inspect_workbook(path):
+    workbook = load_workbook(path)
+    return {
