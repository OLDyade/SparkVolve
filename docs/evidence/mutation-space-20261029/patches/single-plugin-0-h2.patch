+# --------------------------------------------------------------------------- #
+# column helpers
+# --------------------------------------------------------------------------- #
+def _column_letter(col):
+    letters = ""
+    while col > 0:
+        col, rem = divmod(col - 1, 26)
+        letters = chr(65 + rem) + letters
+    return letters
+
+
+def _rowcol_ref(row, col):
+    return f"{_column_letter(col)}{row}"
+
+
+# --------------------------------------------------------------------------- #
+# inspect
+# --------------------------------------------------------------------------- #
+def op_inspect(args):
+    data_only = bool(args.get("data_only"))
+    path = Path(args["file"])
+    if not path.exists():
+        raise ValueError(f"Workbook not found: {path}")
+    workbook = load_workbook(path, data_only=data_only)
+    out = {}
+    for sheet in workbook:
+        rows = []
+        for row in sheet.iter_rows():
+            for cell in row:
+                if cell.value is None and not cell.comment:
+                    continue
+                item = {"cell": cell.coordinate, "value": cell.value}
+                fmt = cell.number_format
+                if fmt and fmt != "General":
+                    item["number_format"] = fmt
+                if cell.comment:
+                    item["comment"] = cell.comment.text
+                rows.append(item)
+        entry = {"cells": rows}
+        if sheet.merged_cells.ranges:
+            entry["merged"] = [str(r) for r in sheet.merged_cells.ranges]
+        out[sheet.title] = entry
+    print(json.dumps(out, default=str))
+
+
+# --------------------------------------------------------------------------- #
+# write
+# --------------------------------------------------------------------------- #
+def _render_template(cell, template):
+    """Expand a relative formula template for one cell.
+
+    ``{col}``/``{col+n}``/``{col-n}`` -> column letter of ``cell`` shifted by n,
+    ``{row}``/``{row+n}``/``{row-n}`` -> row of ``cell`` shifted by n.
+    """
+    r, c = coordinate_to_tuple(cell)
+
+    def repl(match):
+        kind = match.group(1)
+        offset = int((match.group(2) or "0").replace(" ", ""))
+        if kind == "col":
+            return _column_letter(c + offset)
+        return str(r + offset)
+
+    return re.sub(r"\{\s*(col|row)\s*([+-]\s*\d+)?\s*\}", repl, template)
+
+
+def op_write(args):
+    target = Path(args["destination"]).resolve()
+    if not str(target).startswith("/workspace/"):
+        raise ValueError("Destination must be inside /workspace")
+    source = Path(args["source"]).resolve()
+    workbook = load_workbook(source, keep_vba=source.suffix.lower() == ".xlsm")
+    edits = list(args.get("edits") or [])
+    fill = args.get("fill") or []
+
     seen = set()
-    for edit in args['edits']:
-        position = (edit['sheet'], coordinate_to_tuple(edit['cell']))
