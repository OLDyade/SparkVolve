+    def take(sheet_name, cell):
+        cell = cell.upper().replace("$", "")
+        position = (sheet_name, coordinate_to_tuple(cell))
         if position in seen:
-            raise ValueError('Duplicate target')
+            raise ValueError(f"Duplicate target: {sheet_name}!{cell}")
         seen.add(position)
-        workbook[edit['sheet']][edit['cell']] = edit['value']
+        return cell
+
+    for edit in edits:
