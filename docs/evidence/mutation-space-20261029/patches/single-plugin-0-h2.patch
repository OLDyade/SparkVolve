+        if sheet_name not in workbook.sheetnames:
+            raise ValueError(f"Unknown sheet: {sheet_name}")
+        cell = take(sheet_name, edit["cell"])
+        value = edit.get("formula")
+        if value is None:
+            value = edit.get("value")
+        elif not value.startswith("="):
