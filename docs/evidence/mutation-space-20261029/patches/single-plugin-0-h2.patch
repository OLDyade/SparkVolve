+"""Spreadsheet helpers for the harness: inspect, write and verify XLSX workbooks.
+
+Dependency-light (openpyxl only). The module never guesses business semantics:
+formulas are written exactly as supplied by the caller and the verifier only
+reports what an independent engine computed.
+"""
+
 import json
+import re
+import shutil
+import subprocess
 import sys
+import tempfile
 from pathlib import Path
+
 from openpyxl import load_workbook
 from openpyxl.utils.cell import coordinate_to_tuple
 
