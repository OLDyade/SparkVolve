+# --------------------------------------------------------------------------- #
+# verify through an independent engine (LibreOffice)
+# --------------------------------------------------------------------------- #
+def _find_soffice():
+    for name in ("soffice", "libreoffice"):
+        found = shutil.which(name)
+        if found:
+            return found
+    for candidate in (
+        "/usr/bin/soffice",
+        "/usr/lib/libreoffice/program/soffice",
+        "/opt/libreoffice/program/soffice",
+    ):
+        if Path(candidate).exists():
+            return candidate
+    return None
+
+
+def _recalculate(path):
+    soffice = _find_soffice()
+    if soffice is None:
+        raise RuntimeError("LibreOffice (soffice) is not available for recalculation")
+    outdir = Path(tempfile.mkdtemp(prefix="wbverify-"))
+    profile = outdir / "profile"
+    cmd = [
+        soffice,
+        "--headless",
+        "--norestore",
+        f"-env:UserInstallation=file://{profile}",
+        "--convert-to",
+        "xlsx",
+        "--outdir",
+        str(outdir),
+        str(path),
+    ]
+    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
+    if proc.returncode != 0:
+        raise RuntimeError(f"LibreOffice recalculation failed: {proc.stderr.strip()}")
+    converted = outdir / (Path(path).stem + ".xlsx")
+    if not converted.exists():
+        matches = sorted(outdir.glob("*.xlsx"))
+        if not matches:
+            raise RuntimeError("LibreOffice produced no workbook")
+        converted = matches[0]
+    return converted
+
+
+def _expand_range(ref, default_sheet):
+    """Expand ``Sheet!A1:B3`` into (sheet, [cell, ...]); None when not a range."""
+    if ":" not in ref:
+        return None
+    sheet_name = default_sheet
+    body = ref
+    if "!" in ref:
+        sheet_name, body = ref.rsplit("!", 1)
+        sheet_name = sheet_name.strip("'")
+    start, _, end = body.partition(":")
+    r1, c1 = coordinate_to_tuple(start.replace("$", ""))
+    r2, c2 = coordinate_to_tuple((end or start).replace("$", ""))
+    return sheet_name, [
+        _rowcol_ref(r, c)
+        for r in range(min(r1, r2), max(r1, r2) + 1)
+        for c in range(min(c1, c2), max(c1, c2) + 1)
+    ]
+
+
+def _requested_positions(checks):
+    positions = set()
+    for check in checks:
+        sheet = check.get("sheet") or ""
+        expanded = _expand_range(check["range"], sheet)
+        if expanded is None:
+            ref = check["range"]
+            positions.add((check.get("sheet") or sheet, ref.replace("$", "").upper()))
+        else:
+            name, cells = expanded
+            for cell in cells:
+                positions.add((name, cell))
+    return positions
+
+
+def op_verify(args):
+    target = Path(args["file"]).resolve()
+    if not target.exists():
+        raise ValueError(f"Workbook not found: {target}")
+    checks = args.get("checks") or []
+    formulas = load_workbook(target, data_only=False)
+    converted = _recalculate(target)
+    values = load_workbook(converted, data_only=True)
+
+    results = []
+    for check in checks:
+        sheet = check.get("sheet") or formulas.sheetnames[0]
+        if sheet not in formulas.sheetnames:
+            results.append({"range": check["range"], "error": f"unknown sheet {sheet}"})
+            continue
+        expanded = _expand_range(check["range"], sheet)
+        if expanded is None:
+            sheet_for_cells, cells = sheet, [check["range"].replace("$", "").upper()]
+        else:
+            sheet_for_cells, cells = expanded
+        if sheet_for_cells not in values.sheetnames:
+            results.append({"range": check["range"], "error": f"unknown sheet {sheet_for_cells}"})
+            continue
+        items = []
+        for cell in cells:
+            formula = formulas[sheet_for_cells][cell].value
+            value = values[sheet_for_cells][cell].value
+            is_formula = isinstance(formula, str) and formula.startswith("=")
+            item = {
+                "cell": cell,
+                "has_formula": is_formula,
+                "value": value,
+            }
+            if is_formula:
+                item["formula"] = formula
+            if isinstance(value, str) and value.startswith("#"):
+                item["error"] = value
+            items.append(item)
+        results.append({"sheet": sheet_for_cells, "range": check["range"], "cells": items})
+
+    differences = []
+    source = args.get("source")
+    if source:
+        src = load_workbook(source, data_only=False)
+        requested = _requested_positions(checks)
+        for ws in src:
+            if ws.title not in formulas.sheetnames:
+                differences.append({"sheet": ws.title, "issue": "sheet removed"})
+                continue
+            target_ws = formulas[ws.title]
+            for row in ws.iter_rows():
+                for cell in row:
+                    here = target_ws[cell.coordinate].value
+                    there = cell.value
+                    if here != there:
+                        differences.append(
+                            {
+                                "sheet": ws.title,
+                                "cell": cell.coordinate,
+                                "source": there,
+                                "target": here,
+                                "requested": (ws.title, cell.coordinate) in requested,
+                            }
+                        )
+        for name in formulas.sheetnames:
+            if name not in src.sheetnames:
+                differences.append({"sheet": name, "issue": "sheet added"})
+
+    print(
+        json.dumps(
+            {
+                "file": str(target),
+                "checks": results,
+                "differences_vs_source": differences,
+                "errors": [
+                    f"{item.get('sheet')}!{c['cell']}: {c['error']}"
+                    for item in results
+                    for c in item.get("cells", [])
+                    if c.get("error")
+                ],
+                "recalculated_by": "LibreOffice",
+            },
+            default=str,
+        )
+    )
+
+
+def main():
+    args = json.load(sys.stdin)
+    operation = args.get("operation")
+    if operation == "inspect":
+        op_inspect(args)
+    elif operation == "write":
+        op_write(args)
+    elif operation == "verify":
+        op_verify(args)
+    else:
+        raise ValueError("Unknown workbook operation")
+
+
+if __name__ == "__main__":
+    main()
