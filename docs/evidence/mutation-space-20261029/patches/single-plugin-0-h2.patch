+        start, end = rng.split(":")
+        r1, c1 = coordinate_to_tuple(start)
+        r2, c2 = coordinate_to_tuple(end)
+        for r in range(min(r1, r2), max(r1, r2) + 1):
+            for c in range(min(c1, c2), max(c1, c2) + 1):
+                ref = take(sheet_name, _rowcol_ref(r, c))
+                text = _render_template(ref, block["template"])
+                sheet[ref].value = text if text.startswith("=") else "=" + text
+
     target.parent.mkdir(parents=True, exist_ok=True)
     workbook.save(target)
-    print(json.dumps({'saved': str(target), 'submitted_cells': len(seen), 'formula_values_recalculated': False}))
-else:
-    raise ValueError('Unknown workbook operation')
+    print(
+        json.dumps(
+            {
+                "saved": str(target),
+                "submitted_cells": len(seen),
+                "formula_values_recalculated": False,
+            }
+        )
+    )
