{
  "name": "@harness-evolution/dsh-bundle",
  "version": "0.0.0-development",
  "description": "Native DSH plugins for evidence-driven harness evolution",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OLDyade/spark-harness-evolution.git"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./dist/plugin.js",
    "./contracts": "./dist/contracts.js"
  },
  "bin": {
    "harness-evolve": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "11.md",
    "SECURITY.md",
    "docs/architecture.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests examples .github package.json tsconfig.json tsconfig.tests.json cordis.patch.yml",
    "format:check": "prettier --check src tests examples .github package.json tsconfig.json tsconfig.tests.json cordis.patch.yml",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "npm run build && node --import tsx --test tests/native/*.test.ts",
    "test:container": "npm run build && node --import tsx --test tests/container/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:native",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "pnpm": "12.15.0",
    "prettier": "3.9.10",
    "tsx": "4.23.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "pnpm@12.15.0": true,
    "esbuild@0.28.2": true,
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.4": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  },
  "overrides": {
    "zod": "$zod",
    "yaml": "$yaml",
    "undici": "8.12.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0"
  }
}
