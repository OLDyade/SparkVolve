{
  "name": "@harness-evolution/dsh-bundle",
  "version": "0.0.0-development",
  "description": "Native DSH plugins for evidence-driven harness evolution",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OLDyade/spark-harness-evolution.git"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "exports": {
    ".": "./dist/plugin.js",
    "./sdk-preset": "./dist/sdk-preset.js",
    "./preset": "./dist/preset.js",
    "./native-authoring": "./dist/native-authoring.js",
    "./contracts": "./dist/contracts.js",
    "./study": "./dist/study-plugin.js",
    "./study-contracts": "./dist/optimizer-study-contracts.js"
  },
  "bin": {
    "harness-evolve": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "11.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "optimizers",
    "examples",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node scripts/start.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests examples optimizers .github package.json tsconfig.json tsconfig.tests.json cordis.patch.yml",
    "format:check": "prettier --check src tests examples optimizers .github package.json tsconfig.json tsconfig.tests.json cordis.patch.yml",
    "test": "node --import tsx --test tests/*.test.ts tests/optimizer-study-driver.test.mjs tests/feedback-study-driver.test.mjs tests/native-authoring-driver.test.mjs tests/example-timeouts.test.mjs tests/installed-capability-driver.test.mjs tests/start.test.mjs",
    "test:native": "npm run build && node --import tsx --test tests/native/*.test.ts",
    "test:container": "npm run build && node --import tsx --test tests/container/*.test.ts",
    "check": "npm run format:check && npm run docs:check && npm run typecheck && npm test && npm run test:native",
    "docs:check": "node scripts/check-language.mjs && node scripts/render-tour.mjs --check",
    "prepack": "npm run build",
    "package:artifacts": "node scripts/package-artifacts.mjs",
    "test:install": "npm run build && node --test tests/install.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.4",
    "@deepseek-ai/dsh-cordis-host-runner": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sdk-client": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-cordis": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "ipaddr.js": "2.5.0",
    "undici": "8.12.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@types/node": "24.10.1",
    "pnpm": "12.15.0",
    "prettier": "3.9.10",
    "tsx": "4.23.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "pnpm@12.15.0": true,
    "esbuild@0.28.2": true,
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.4": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.21.0": true
  },
  "overrides": {
    "zod": "$zod",
    "yaml": "$yaml",
    "undici": "8.12.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0"
  },
  "homepage": "https://github.com/OLDyade/spark-harness-evolution#readme",
  "bugs": {
    "url": "https://github.com/OLDyade/spark-harness-evolution/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "harness-evolution",
    "agent",
    "benchmark"
  ]
}
